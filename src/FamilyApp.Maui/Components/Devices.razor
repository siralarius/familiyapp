@page "/devices"
@using FamilyApp.Maui
@using FamilyApp.Sync.Pairing
@using Microsoft.AspNetCore.Components
@inject IDevicePairingService Pairing
@inject IQrScanner QrScanner
@inject IQrCodeRenderer QrCodeRenderer

<div class="page">
    <h1>Family devices</h1>
    <p>Keep both phones open on the same Wi-Fi while pairing and syncing.</p>
    <p>Your family code: <strong>@Pairing.Identity.FamilyId</strong></p>
    <p>On a new phone, scan the offer QR code and confirm joining before adding household data.</p>
    <button class="primary-button" @onclick="CreateOfferQr">Create offer QR code</button>
    @if (!string.IsNullOrEmpty(offerQrImage))
    {
        <p>Scan this code on the new phone:</p>
        <img alt="Pairing offer QR code" src="@offerQrImage" style="max-width:260px;width:100%;height:auto;" />
    }

    <h2>Join from this phone</h2>
    <p>Scan an offer from another phone, confirm joining that family, then show the response QR code back to the first phone.</p>
    <button class="secondary-button" @onclick="ScanOfferQr">Scan offer QR code</button>
    @if (pendingOfferFamilyId is Guid targetFamily)
    {
        <p>Scanned family <strong>@targetFamily</strong>. Confirm joining this family and create your response QR code.</p>
        <button class="primary-button" @onclick="ConfirmOffer">Confirm and create response QR code</button>
    }
    @if (!string.IsNullOrEmpty(responseQrImage))
    {
        <p>Show this response QR code to the first phone:</p>
        <img alt="Pairing response QR code" src="@responseQrImage" style="max-width:260px;width:100%;height:auto;" />
    }

    <h2>Complete on first phone</h2>
    <p>Scan the response QR code from the second phone to finish pairing.</p>
    <button class="secondary-button" @onclick="ScanResponseQr">Scan response QR code</button>

    <h2>Manual fallback</h2>
    <p>If camera scanning is unavailable, manual code entry still works.</p>
    <input placeholder="Family code from the other phone" @bind="familyCode" />
    <button class="secondary-button" @onclick="Join">Join family</button>
    <button class="secondary-button" @onclick="Offer">Create pairing offer code</button>
    <textarea aria-label="Pairing code from the other phone" @bind="incoming"></textarea>
    <button class="secondary-button" @onclick="Accept">Accept offer code</button>
    <button class="secondary-button" @onclick="Complete">Complete pairing</button>
    @if (!string.IsNullOrEmpty(outgoing))
    {
        <p>Copy this code to the other phone:</p>
        <textarea aria-label="Generated pairing code" readonly value="@outgoing"></textarea>
    }
    <p role="status">@message</p>
    <a href="/more">Back to sync status</a>
</div>

@code {
    private readonly HashSet<string> recentScans = new(StringComparer.Ordinal);
    private string familyCode = "", incoming = "", outgoing = "", message = "", offerQrImage = "", responseQrImage = "";
    private string? pendingOfferPayload;
    private Guid? pendingOfferFamilyId;

    private Task Join() => Run(async () => { await Pairing.JoinFamilyAsync(Guid.Parse(familyCode)); message = "Family selected."; });
    private Task Offer() => Run(async () => { outgoing = await Pairing.CreateOfferAsync(); message = "Offer ready."; });
    private Task Accept() => Run(async () => { outgoing = await Pairing.AcceptOfferAsync(incoming.Trim()); message = "Response ready. Complete pairing on the first phone."; });
    private Task Complete() => Run(async () => { await Pairing.CompletePairingAsync(incoming.Trim()); outgoing = ""; message = "Paired. Sync starts automatically while both phones are open."; });

    private Task CreateOfferQr() => Run(async () =>
    {
        var offer = await Pairing.CreateOfferAsync();
        offerQrImage = await QrCodeRenderer.RenderPngDataUrlAsync(offer);
        message = "Offer QR code ready. It expires in five minutes.";
    });

    private Task ScanOfferQr() => ScanAndHandleAsync(expectOffer: true);
    private Task ScanResponseQr() => ScanAndHandleAsync(expectOffer: false);

    private Task ConfirmOffer() => Run(async () =>
    {
        if (pendingOfferPayload is null || pendingOfferFamilyId is null)
            throw new InvalidOperationException("Scan an offer QR code first.");

        await Pairing.JoinFamilyAsync(pendingOfferFamilyId.Value);
        var response = await Pairing.AcceptOfferAsync(pendingOfferPayload);
        responseQrImage = await QrCodeRenderer.RenderPngDataUrlAsync(response);
        outgoing = response;
        pendingOfferPayload = null;
        pendingOfferFamilyId = null;
        message = "Response QR code ready. Show it on this phone so the first phone can scan it.";
    });

    private async Task ScanAndHandleAsync(bool expectOffer)
    {
        var scan = await QrScanner.ScanAsync();
        if (scan.Status == QrScanStatus.PermissionDenied)
        {
            message = "Camera access is required to scan QR codes. Enable camera permission in iPhone Settings or use manual pairing.";
            return;
        }
        if (scan.Status == QrScanStatus.Canceled)
        {
            message = "QR scan canceled.";
            return;
        }
        if (scan.Status == QrScanStatus.Unsupported || string.IsNullOrWhiteSpace(scan.Payload))
        {
            message = "QR scanning is unavailable on this device. Use manual pairing.";
            return;
        }
        if (!recentScans.Add(scan.Payload))
        {
            message = "That QR code was already scanned. Use a new code or wait for a fresh offer.";
            return;
        }

        await Run(async () =>
        {
            var details = PairingCoordinator.InspectQrPayload(scan.Payload);
            if (expectOffer)
            {
                if (details.Kind != PairingQrPayloadKind.Offer)
                    throw new InvalidOperationException("Scan a pairing offer QR code from the first phone.");
                pendingOfferPayload = scan.Payload;
                pendingOfferFamilyId = details.FamilyId;
                message = $"Offer scanned from family {details.FamilyId}. Confirm to join and create your response code.";
                return;
            }

            if (details.Kind != PairingQrPayloadKind.Response)
                throw new InvalidOperationException("Scan a pairing response QR code from the second phone.");

            await Pairing.CompletePairingAsync(scan.Payload);
            pendingOfferPayload = null;
            pendingOfferFamilyId = null;
            responseQrImage = "";
            outgoing = "";
            message = "Paired. Sync starts automatically while both phones are open.";
        });
    }

    private async Task Run(Func<Task> action)
    {
        try { await action(); }
        catch (FormatException) { message = "Enter a valid family code."; }
        catch (InvalidOperationException exception) { message = exception.Message; }
        catch { message = "Pairing could not finish. Check the code and try again."; }
    }
}
