    <OutputType>Exe</OutputType>
    <RootNamespace>FamilyApp.Maui</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <ApplicationTitle>Family App</ApplicationTitle>
    <ApplicationId>com.siralarius.familyapp</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
  </PropertyGroup>
  <ItemGroup>
    <MauiIcon Include="Resources/AppIcon/appicon.svg" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.101" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="10.0.101" />
    <ProjectReference Include="../FamilyApp.Shared/FamilyApp.Shared.csproj" />
    <ProjectReference Include="../FamilyApp.Data/FamilyApp.Data.csproj" />
  </ItemGroup>
