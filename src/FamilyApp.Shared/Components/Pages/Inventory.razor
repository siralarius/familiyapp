@page "/inventory"
@using FamilyApp.Core.Inventory
@inject InventoryService InventoryService
<PageTitle>Inventory · Family</PageTitle>
<div class="page"><header class="page-heading"><p class="eyebrow">Household</p><h1>Inventory</h1><p class="lede">Keep an eye on the staples you never want to run out of.</p></header>
<form class="inventory-form" @onsubmit="Add" @onsubmit:preventDefault><input placeholder="Item, e.g. Milk" @bind="name"/><label>Have<input type="number" min="0" step="1" @bind="quantity"/></label><label>Low at<input type="number" min="0" step="1" @bind="threshold"/></label><label class="auto-check"><input type="checkbox" @bind="autoAdd"/> Auto-add when low</label><button disabled="@string.IsNullOrWhiteSpace(name)">Add</button></form>
@if(!loaded){<p class="loading">Loading inventory…</p>}else if(items.Count==0){<section class="empty-state"><span class="empty-icon">▦</span><h2>No staples yet</h2><p>Add milk, eggs, pasta or anything your household keeps on hand.</p></section>}else{<div class="inventory-grid">@foreach(var item in items.OrderByDescending(x=>x.IsLow)){<section class="inventory-card @(item.IsLow?"low":"")"><div><p class="card-label">@(item.IsLow?"Running low":"In stock")</p><h2>@item.Name</h2><p>@item.Quantity on hand · low at @item.LowThreshold</p>@if(item.AutoAddToShoppingList){<span class="auto-badge">Auto-add on</span>}</div><div class="inventory-actions">@if(item.IsLow){<button @onclick="()=>AddToList(item.Id)">Add to shopping</button>}<button class="item-action danger" @onclick="()=>Remove(item.Id)">Remove</button></div></section>}</div>}</div>
@code{private List<InventoryItem> items=[];private bool loaded;private string? name;private decimal quantity=1,threshold=1;private bool autoAdd;protected override async Task OnAfterRenderAsync(bool first){if(!first)return;await Refresh();loaded=true;StateHasChanged();}private async Task Refresh()=>items=(await InventoryService.GetAllAsync()).ToList();private async Task Add(){if(string.IsNullOrWhiteSpace(name))return;await InventoryService.AddAsync(name,quantity,threshold,autoAdd);name=null;quantity=threshold=1;autoAdd=false;await Refresh();}private async Task AddToList(Guid id){await InventoryService.AddLowToShoppingAsync(id);await Refresh();}private async Task Remove(Guid id){await InventoryService.RemoveAsync(id);await Refresh();}}
