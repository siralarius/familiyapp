@page "/meals"
@using FamilyApp.Core.Meals
@inject MealPlanService MealPlanner
@inject MealPlanningImportService MealPlanningImport

<PageTitle>Meals · Family</PageTitle>
<div class="page">
    <header class="page-heading meal-heading">
        <div>
            <p class="eyebrow">Weekly plan</p>
            <h1>Meals</h1>
            <p class="lede">@weekStart.ToString("d MMM") – @weekStart.AddDays(6).ToString("d MMM yyyy")</p>
        </div>
        <div class="week-nav">
            <button @onclick="() => MoveWeek(-7)">←</button>
            <button @onclick="ThisWeek">Today</button>
            <button @onclick="() => MoveWeek(7)">→</button>
        </div>
    </header>

    <section class="import-panel">
        <div class="import-heading">
            <div>
                <p class="card-label">ChatGPT import</p>
                <h2>Import conversation draft</h2>
            </div>
        </div>
        <p class="import-note">
            Start this manually: talk in ChatGPT, ask for Family App meal-planning JSON contract <code>v1</code>, then paste it here.
            Family App does not background-listen to other apps or auto-read voice chats.
        </p>
        <p class="import-note">
            The JSON must include <code>version</code>, optional <code>weekStart</code>, <code>meals</code>, <code>shoppingItems</code>, and optional <code>unresolvedQuestions</code>.
            Mark shopping <code>source</code> as <code>explicit</code> or <code>inferred</code>; inferred items require confirmation before save.
        </p>
        <p class="import-note">
            Processing note: conversation audio/transcript is handled by the service you use to create the JSON (for example ChatGPT account/API).
            Family App receives only pasted JSON and saves approved entries locally before sync.
        </p>
        <textarea class="import-json" placeholder="Paste JSON export from ChatGPT..." @bind="importJson"></textarea>
        <div class="import-actions">
            <button class="secondary-button" @onclick="BuildDraftAsync">Build draft</button>
            <button class="primary-button" disabled="@(importDraft is null || importSaving)" @onclick="SaveDraftAsync">Save selected items</button>
        </div>

        @if (importErrors.Count > 0)
        {
            <ul class="import-errors">
                @foreach (var error in importErrors)
                {
                    <li>@error</li>
                }
            </ul>
        }

        @if (!string.IsNullOrWhiteSpace(importStatus))
        {
            <p class="@(importStatusIsError ? "import-status error" : "import-status")">@importStatus</p>
        }

        @if (importDraft is not null)
        {
            if (importDraft.UnresolvedQuestions.Count > 0)
            {
                <div class="import-unresolved">
                    <p class="card-label">Needs clarification</p>
                    <ul>
                        @foreach (var unresolved in importDraft.UnresolvedQuestions.Distinct())
                        {
                            <li>@unresolved</li>
                        }
                    </ul>
                </div>
            }

            <div class="import-review-grid">
                <section class="import-review-card">
                    <p class="card-label">Meals draft</p>
                    @if (importDraft.Meals.Count == 0)
                    {
                        <p class="loading">No meals found in this import.</p>
                    }
                    else
                    {
                        @foreach (var meal in importDraft.Meals)
                        {
                            <div class="draft-row">
                                <label class="row-include"><input type="checkbox" @bind="meal.Include" />Include</label>
                                <input placeholder="YYYY-MM-DD" @bind="meal.Date" />
                                <select @bind="meal.MealSlot">
                                    <option value="">Meal slot</option>
                                    <option value="breakfast">Breakfast</option>
                                    <option value="lunch">Lunch</option>
                                    <option value="dinner">Dinner</option>
                                </select>
                                <input placeholder="Dish" @bind="meal.Dish" />
                                <input placeholder="Notes (optional)" @bind="meal.Notes" />
                                <label class="row-inline"><input type="checkbox" @bind="meal.IsAgreed" />Agreed</label>
                                @if (meal.HasConflict)
                                {
                                    <label class="row-inline"><input type="checkbox" @bind="meal.ReplaceExisting" />Replace '@meal.ConflictDescription'</label>
                                }
                                @if (meal.Issues.Count > 0)
                                {
                                    <p class="draft-issues">@string.Join(" ", meal.Issues)</p>
                                }
                            </div>
                        }
                    }
                </section>

                <section class="import-review-card">
                    <p class="card-label">Shopping draft</p>
                    @if (importDraft.ShoppingItems.Count == 0)
                    {
                        <p class="loading">No shopping items found in this import.</p>
                    }
                    else
                    {
                        @foreach (var item in importDraft.ShoppingItems)
                        {
                            <div class="draft-row">
                                <label class="row-include"><input type="checkbox" @bind="item.Include" />Include</label>
                                <input placeholder="Product" @bind="item.Name" />
                                <input placeholder="Qty" @bind="item.Quantity" />
                                <input placeholder="Unit" @bind="item.Unit" />
                                <span class="source-badge">@item.Source</span>
                                @if (item.IsInferred)
                                {
                                    <label class="row-inline"><input type="checkbox" @bind="item.ConfirmInferred" />Confirm inferred item</label>
                                }
                                @if (item.Issues.Count > 0)
                                {
                                    <p class="draft-issues">@string.Join(" ", item.Issues)</p>
                                }
                            </div>
                        }
                    }
                </section>
            </div>
        }
    </section>

    @if (!loaded)
    {
        <p class="loading">Loading meals…</p>
    }
    else
    {
        <div class="week-grid">
            @for (var offset = 0; offset < 7; offset++)
            {
                var day = weekStart.AddDays(offset);
                var dayEntries = entries.Where(x => x.Date == day).ToList();
                <section class="day-card">
                    <div class="day-title"><span>@day.ToString("ddd")</span><strong>@day.Day</strong></div>
                    <div class="day-meals">
                        @foreach (var meal in dayEntries)
                        {
                            <button class="meal-chip" @onclick="() => BeginEdit(meal)"><span>@meal.MealType</span><strong>@meal.Description</strong></button>
                        }
                        <button class="add-meal" @onclick="() => BeginAdd(day)">+ Add meal</button>
                    </div>
                </section>
            }
        </div>
    }

    @if (editDate is not null)
    {
        <div class="meal-editor">
            <div>
                <p class="card-label">@((editingId is null) ? "Add meal" : "Edit meal") · @editDate.Value.ToString("ddd d MMM")</p>
                <div class="meal-fields">
                    <select @bind="editType">
                        @foreach (var type in Enum.GetValues<MealType>())
                        {
                            <option value="@type">@type</option>
                        }
                    </select>
                    <input placeholder="What are you eating?" @bind="description" />
                    <input placeholder="Notes (optional)" @bind="notes" />
                </div>
                <div class="editor-actions">
                    @if (editingId is not null)
                    {
                        <button class="danger-button" @onclick="Remove">Delete</button>
                    }
                    <span></span>
                    <button class="secondary-button" @onclick="Cancel">Cancel</button>
                    <button class="primary-button" disabled="@string.IsNullOrWhiteSpace(description)" @onclick="Save">Save</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private DateOnly weekStart = MealPlanService.StartOfWeek(DateOnly.FromDateTime(DateTime.Today));
    private List<MealPlanEntry> entries = [];
    private bool loaded;

    private DateOnly? editDate;
    private Guid? editingId;
    private MealType editType = MealType.Dinner;
    private string? description;
    private string? notes;

    private string importJson = string.Empty;
    private MealPlanningImportDraft? importDraft;
    private readonly List<string> importErrors = [];
    private bool importSaving;
    private string? importStatus;
    private bool importStatusIsError;

    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (!first)
            return;

        await Refresh();
        loaded = true;
        StateHasChanged();
    }

    private async Task Refresh() => entries = (await MealPlanner.GetWeekAsync(weekStart)).ToList();

    private async Task MoveWeek(int days)
    {
        weekStart = weekStart.AddDays(days);
        Cancel();
        await Refresh();
    }

    private Task ThisWeek()
    {
        weekStart = MealPlanService.StartOfWeek(DateOnly.FromDateTime(DateTime.Today));
        Cancel();
        return Refresh();
    }

    private void BeginAdd(DateOnly date)
    {
        editDate = date;
        editingId = null;
        editType = MealType.Dinner;
        description = notes = null;
    }

    private void BeginEdit(MealPlanEntry meal)
    {
        editDate = meal.Date;
        editingId = meal.Id;
        editType = meal.MealType;
        description = meal.Description;
        notes = meal.Notes;
    }

    private void Cancel()
    {
        editDate = null;
        editingId = null;
        description = notes = null;
    }

    private async Task Save()
    {
        if (editDate is null || string.IsNullOrWhiteSpace(description))
            return;

        if (editingId is Guid id)
            await MealPlanner.UpdateAsync(id, editType, description, notes);
        else
            await MealPlanner.AddAsync(editDate.Value, editType, description, notes);

        Cancel();
        await Refresh();
    }

    private async Task Remove()
    {
        if (editingId is Guid id)
            await MealPlanner.RemoveAsync(id);

        Cancel();
        await Refresh();
    }

    private async Task BuildDraftAsync()
    {
        importErrors.Clear();
        importStatus = null;

        var result = await MealPlanningImport.BuildDraftAsync(importJson);
        if (!result.IsSuccess || result.Draft is null)
        {
            importDraft = null;
            importErrors.AddRange(result.Errors);
            importStatus = "Draft could not be prepared.";
            importStatusIsError = true;
            return;
        }

        importDraft = result.Draft;
        importStatus = "Draft ready. Review and confirm before saving.";
        importStatusIsError = false;
    }

    private async Task SaveDraftAsync()
    {
        if (importDraft is null)
            return;

        importSaving = true;
        importErrors.Clear();
        importStatus = null;

        var result = await MealPlanningImport.SaveDraftAsync(importDraft);
        importSaving = false;

        if (!result.IsSuccess)
        {
            importErrors.AddRange(result.Errors);
            importStatus = "Import not saved. Fix the highlighted issues first.";
            importStatusIsError = true;
            return;
        }

        importStatus =
            $"Saved: {result.MealsAdded} meals added, {result.MealsUpdated} replaced, {result.MealsSkipped} skipped; " +
            $"{result.ShoppingAdded} shopping items added, {result.ShoppingSkipped} skipped.";
        importStatusIsError = false;

        await Refresh();
        StateHasChanged();
    }
}
