@page "/meals"
@using FamilyApp.Core.Meals
@inject MealPlanService MealPlanner
<PageTitle>Meals · Family</PageTitle>
<div class="page"><header class="page-heading meal-heading"><div><p class="eyebrow">Weekly plan</p><h1>Meals</h1><p class="lede">@weekStart.ToString("d MMM") – @weekStart.AddDays(6).ToString("d MMM yyyy")</p></div><div class="week-nav"><button @onclick="()=>MoveWeek(-7)">←</button><button @onclick="ThisWeek">Today</button><button @onclick="()=>MoveWeek(7)">→</button></div></header>
@if(!loaded){<p class="loading">Loading meals…</p>}else{<div class="week-grid">@for(var offset=0;offset<7;offset++){var day=weekStart.AddDays(offset);var dayEntries=entries.Where(x=>x.Date==day).ToList();<section class="day-card"><div class="day-title"><span>@day.ToString("ddd")</span><strong>@day.Day</strong></div><div class="day-meals">@foreach(var meal in dayEntries){<button class="meal-chip" @onclick="()=>BeginEdit(meal)"><span>@meal.MealType</span><strong>@meal.Description</strong></button>}<button class="add-meal" @onclick="()=>BeginAdd(day)">+ Add meal</button></div></section>}</div>}
@if(editDate is not null){<div class="meal-editor"><div><p class="card-label">@((editingId is null)?"Add meal":"Edit meal") · @editDate.Value.ToString("ddd d MMM")</p><div class="meal-fields"><select @bind="editType">@foreach(var type in Enum.GetValues<MealType>()){<option value="@type">@type</option>}</select><input placeholder="What are you eating?" @bind="description"/><input placeholder="Notes (optional)" @bind="notes"/></div><div class="editor-actions">@if(editingId is not null){<button class="danger-button" @onclick="Remove">Delete</button>}<span></span><button class="secondary-button" @onclick="Cancel">Cancel</button><button class="primary-button" disabled="@string.IsNullOrWhiteSpace(description)" @onclick="Save">Save</button></div></div></div>}</div>
@code{private DateOnly weekStart=MealPlanService.StartOfWeek(DateOnly.FromDateTime(DateTime.Today));private List<MealPlanEntry>entries=[];private bool loaded;private DateOnly? editDate;private Guid? editingId;private MealType editType=MealType.Dinner;private string?description,notes;protected override async Task OnAfterRenderAsync(bool first){if(!first)return;await Refresh();loaded=true;StateHasChanged();}private async Task Refresh()=>entries=(await MealPlanner.GetWeekAsync(weekStart)).ToList();private async Task MoveWeek(int days){weekStart=weekStart.AddDays(days);Cancel();await Refresh();}private Task ThisWeek(){weekStart=MealPlanService.StartOfWeek(DateOnly.FromDateTime(DateTime.Today));Cancel();return Refresh();}private void BeginAdd(DateOnly d){editDate=d;editingId=null;editType=MealType.Dinner;description=notes=null;}private void BeginEdit(MealPlanEntry m){editDate=m.Date;editingId=m.Id;editType=m.MealType;description=m.Description;notes=m.Notes;}private void Cancel(){editDate=null;editingId=null;description=notes=null;}private async Task Save(){if(editDate is null||string.IsNullOrWhiteSpace(description))return;if(editingId is Guid id)await MealPlanner.UpdateAsync(id,editType,description,notes);else await MealPlanner.AddAsync(editDate.Value,editType,description,notes);Cancel();await Refresh();}private async Task Remove(){if(editingId is Guid id)await MealPlanner.RemoveAsync(id);Cancel();await Refresh();}}
