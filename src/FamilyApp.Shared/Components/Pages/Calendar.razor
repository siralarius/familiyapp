@page "/calendar"
@using FamilyApp.Core.Calendar
@inject FamilyCalendarService CalendarService
<PageTitle>Calendar · Family</PageTitle>
<div class="page"><header class="page-heading calendar-heading"><div><p class="eyebrow">Family time</p><h1>Calendar</h1><p class="lede">@anchor.ToString("MMMM yyyy")</p></div><div class="week-nav"><button @onclick="()=>Move(-7)">←</button><button @onclick="Today">Today</button><button @onclick="()=>Move(7)">→</button></div></header>
<div class="calendar-days">@foreach(var day in Days()){var dayEvents=events.Where(x=>x.Start.Date==day.Date).ToList();<section class="agenda-day"><button class="agenda-date @(day.Date==DateTime.Today?"today":"")" @onclick="()=>BeginAdd(day)"><span>@day.ToString("ddd")</span><strong>@day.Day</strong></button><div class="agenda-events">@if(dayEvents.Count==0){<button class="agenda-empty" @onclick="()=>BeginAdd(day)">+ Add event</button>}else{@foreach(var ev in dayEvents){<button class="event-card" @onclick="()=>BeginEdit(ev)"><span>@ev.Start.ToString("HH:mm")–@ev.End.ToString("HH:mm")</span><strong>@ev.Title</strong>@if(ev.Member is not null){<small>@ev.Member</small>}</button>}}</div></section>}</div>
@if(editDay is not null){<div class="meal-editor"><div><p class="card-label">@((editingId is null)?"Add event":"Edit event") · @editDay.Value.ToString("ddd d MMM")</p><div class="calendar-fields"><input placeholder="Event title" @bind="title"/><label>Start<input type="time" @bind="startTime"/></label><label>End<input type="time" @bind="endTime"/></label><input placeholder="Family member (optional)" @bind="member"/><input placeholder="Notes (optional)" @bind="notes"/></div>@if(error is not null){<p class="form-error">@error</p>}<div class="editor-actions">@if(editingId is not null){<button class="danger-button" @onclick="Remove">Delete</button>}<span></span><button class="secondary-button" @onclick="Cancel">Cancel</button><button class="primary-button" disabled="@string.IsNullOrWhiteSpace(title)" @onclick="Save">Save</button></div></div></div>}</div>
@code{private DateTime anchor=DateTime.Today;private List<FamilyEvent>events=[];private DateTime?editDay;private Guid?editingId;private string?title,member,notes,error;private string startTime="18:00",endTime="19:00";protected override async Task OnAfterRenderAsync(bool first){if(!first)return;await Refresh();StateHasChanged();}private IEnumerable<DateTime> Days(){var monday=anchor.Date.AddDays(-(((int)anchor.DayOfWeek+6)%7));return Enumerable.Range(0,7).Select(monday.AddDays);}private async Task Refresh(){var days=Days().ToList();events=(await CalendarService.GetRangeAsync(days[0],days[^1].AddDays(1))).ToList();}private async Task Move(int d){anchor=anchor.AddDays(d);Cancel();await Refresh();}private Task Today(){anchor=DateTime.Today;Cancel();return Refresh();}private void BeginAdd(DateTime d){editDay=d;editingId=null;title=member=notes=error=null;startTime="18:00";endTime="19:00";}private void BeginEdit(FamilyEvent e){editDay=e.Start.Date;editingId=e.Id;title=e.Title;member=e.Member;notes=e.Notes;startTime=e.Start.ToString("HH:mm");endTime=e.End.ToString("HH:mm");error=null;}private void Cancel(){editDay=null;editingId=null;error=null;}private async Task Save(){if(editDay is null||string.IsNullOrWhiteSpace(title))return;var start=editDay.Value.Date+TimeSpan.Parse(startTime);var end=editDay.Value.Date+TimeSpan.Parse(endTime);if(end<=start){error="End time must be after start time.";return;}if(editingId is Guid id)await CalendarService.UpdateAsync(id,title,start,end,member,notes);else await CalendarService.AddAsync(title,start,end,member,notes);Cancel();await Refresh();}private async Task Remove(){if(editingId is Guid id)await CalendarService.RemoveAsync(id);Cancel();await Refresh();}}
