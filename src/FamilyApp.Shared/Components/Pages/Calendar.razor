@page "/calendar"
@using FamilyApp.Core.Calendar
@inject FamilyCalendarService CalendarService
@inject IJSRuntime JS
<PageTitle>Calendar · Family</PageTitle>
<div class="google-calendar-bar">
	<div><strong>Google Calendar</strong><span>@googleStatus</span></div>
	@if (!googleConnected)
	{
		<button class="secondary-button" disabled="@(!googleConfigured)" @onclick="ConnectGoogle">Connect</button>
	}
	else
	{
		<button class="secondary-button" @onclick="DisconnectGoogle">Disconnect</button>
	}
</div>
@if (!googleConfigured)
{
	<p class="google-calendar-unavailable">Google Calendar isn’t enabled on this site. Configure the GOOGLE_CLIENT_ID build setting to enable it.</p>
}
@if(googleConnected&&googleCalendars.Count>0){<div class="google-calendar-picker">@foreach(var gc in googleCalendars){<label><input type="checkbox" checked="@selectedGoogle.Contains(gc.Id)" @onchange="e=>ToggleGoogle(gc.Id,(bool)e.Value!)"/><span>@gc.Name</span></label>}</div>}
<div class="page"><header class="page-heading calendar-heading"><div><p class="eyebrow">Family time</p><h1>Calendar</h1><p class="lede">@anchor.ToString("MMMM yyyy")</p></div><div class="week-nav"><button @onclick="()=>Move(-7)">←</button><button @onclick="Today">Today</button><button @onclick="()=>Move(7)">→</button></div></header>
<div class="calendar-days">@foreach(var day in Days()){var dayEvents=events.Where(x=>x.Start.Date==day.Date).ToList();var googleDayEvents=googleEvents.Where(x=>x.Start.Date==day.Date).ToList();<section class="agenda-day"><button class="agenda-date @(day.Date==DateTime.Today?"today":"")" @onclick="()=>BeginAdd(day)"><span>@day.ToString("ddd")</span><strong>@day.Day</strong></button><div class="agenda-events">@if(dayEvents.Count==0&&googleDayEvents.Count==0){<button class="agenda-empty" @onclick="()=>BeginAdd(day)">+ Add event</button>}@foreach(var ev in dayEvents){<button class="event-card" @onclick="()=>BeginEdit(ev)"><span>@ev.Start.ToString("HH:mm")–@ev.End.ToString("HH:mm")</span><strong>@ev.Title</strong>@if(ev.Member is not null){<small>@ev.Member</small>}</button>}@foreach(var ev in googleDayEvents){<div class="event-card google-event"><span>@(ev.AllDay?"All day":$"{ev.Start:HH:mm}–{ev.End:HH:mm}") · Google</span><strong>@ev.Title</strong><small>@CalendarName(ev.CalendarId)</small></div>}</div></section>}</div>
@if(editDay is not null){<div class="meal-editor"><div><p class="card-label">@((editingId is null)?"Add event":"Edit event") · @editDay.Value.ToString("ddd d MMM")</p><div class="calendar-fields"><input placeholder="Event title" @bind="title"/><label>Start<input type="time" @bind="startTime"/></label><label>End<input type="time" @bind="endTime"/></label><input placeholder="Family member (optional)" @bind="member"/><input placeholder="Notes (optional)" @bind="notes"/></div>@if(error is not null){<p class="form-error">@error</p>}<div class="editor-actions">@if(editingId is not null){<button class="danger-button" @onclick="Remove">Delete</button>}<span></span><button class="secondary-button" @onclick="Cancel">Cancel</button><button class="primary-button" disabled="@string.IsNullOrWhiteSpace(title)" @onclick="Save">Save</button></div></div></div>}</div>
@code {
	private sealed record GoogleCalendar(string Id, string Name, bool Primary);
	private sealed record GoogleEvent(string Id, string CalendarId, string Title, DateTime Start, DateTime End, bool AllDay);

	private List<GoogleCalendar> googleCalendars = [];
	private List<GoogleEvent> googleEvents = [];
	private HashSet<string> selectedGoogle = [];
	private bool googleConnected;
	private bool googleConfigured;
	private string googleStatus = "Checking Google Calendar availability";
	private DateTime anchor = DateTime.Today;
	private List<FamilyEvent> events = [];
	private DateTime? editDay;
	private Guid? editingId;
	private string? title, member, notes, error;
	private TimeOnly? startTime = new(18, 0), endTime = new(19, 0);

	protected override async Task OnAfterRenderAsync(bool first)
	{
		if (!first) return;

		try
		{
			googleConfigured = await JS.InvokeAsync<bool>("familyGoogleCalendar.isConfigured");
		}
		catch (JSException)
		{
			googleConfigured = false;
		}

		googleStatus = googleConfigured
			? "Not connected"
			: "Unavailable · Configure GOOGLE_CLIENT_ID to enable Google Calendar";
		await Refresh();
		StateHasChanged();
	}

	private IEnumerable<DateTime> Days()
	{
		var monday = anchor.Date.AddDays(-(((int)anchor.DayOfWeek + 6) % 7));
		return Enumerable.Range(0, 7).Select(index => monday.AddDays(index));
	}

	private async Task Refresh()
	{
		var days = Days().ToList();
		events = (await CalendarService.GetRangeAsync(days[0], days[^1].AddDays(1))).ToList();
		if (!googleConnected || selectedGoogle.Count == 0) return;

		try
		{
			googleEvents = (await JS.InvokeAsync<GoogleEvent[]>(
				"familyGoogleCalendar.events",
				selectedGoogle.ToArray(),
				days[0].ToUniversalTime().ToString("O"),
				days[^1].AddDays(1).ToUniversalTime().ToString("O"))).ToList();
		}
		catch (JSException)
		{
			googleStatus = "Google Calendar events could not be loaded. Reconnect and try again.";
			googleEvents = [];
		}
	}

	private async Task ConnectGoogle()
	{
		if (!googleConfigured)
		{
			googleStatus = "Unavailable · Configure GOOGLE_CLIENT_ID to enable Google Calendar";
			return;
		}

		try
		{
			await JS.InvokeVoidAsync("familyGoogleCalendar.connect");
			var calendars = await JS.InvokeAsync<GoogleCalendar[]>("familyGoogleCalendar.calendars");
			googleCalendars = calendars.ToList();
			selectedGoogle = googleCalendars.Where(calendar => calendar.Primary).Select(calendar => calendar.Id).ToHashSet();
			if (selectedGoogle.Count == 0 && googleCalendars.Count > 0)
				selectedGoogle.Add(googleCalendars[0].Id);
			googleConnected = true;
			googleStatus = $"Connected · {googleCalendars.Count} calendar(s)";
			await Refresh();
		}
		catch (JSException)
		{
			googleStatus = "Google Calendar could not connect. Check the OAuth client and allowed site origins.";
		}
	}

	private async Task DisconnectGoogle()
	{
		await JS.InvokeVoidAsync("familyGoogleCalendar.disconnect");
		googleConnected = false;
		googleCalendars = [];
		googleEvents = [];
		selectedGoogle = [];
		googleStatus = googleConfigured
			? "Not connected"
			: "Unavailable · Configure GOOGLE_CLIENT_ID to enable Google Calendar";
	}

	private async Task ToggleGoogle(string id, bool enabled)
	{
		if (enabled) selectedGoogle.Add(id);
		else selectedGoogle.Remove(id);
		await Refresh();
	}

	private string CalendarName(string id)
		=> googleCalendars.FirstOrDefault(calendar => calendar.Id == id)?.Name ?? "Google Calendar";

	private async Task Move(int days)
	{
		anchor = anchor.AddDays(days);
		Cancel();
		await Refresh();
	}

	private Task Today()
	{
		anchor = DateTime.Today;
		Cancel();
		return Refresh();
	}

	private void BeginAdd(DateTime day)
	{
		editDay = day;
		editingId = null;
		title = member = notes = error = null;
		startTime = new TimeOnly(18, 0);
		endTime = new TimeOnly(19, 0);
	}

	private void BeginEdit(FamilyEvent familyEvent)
	{
		editDay = familyEvent.Start.Date;
		editingId = familyEvent.Id;
		title = familyEvent.Title;
		member = familyEvent.Member;
		notes = familyEvent.Notes;
		startTime = TimeOnly.FromDateTime(familyEvent.Start);
		endTime = TimeOnly.FromDateTime(familyEvent.End);
		error = null;
	}

	private void Cancel()
	{
		editDay = null;
		editingId = null;
		error = null;
	}

	private async Task Save()
	{
		if (editDay is null || string.IsNullOrWhiteSpace(title) || startTime is null || endTime is null) return;
		var start = editDay.Value.Date + startTime.Value.ToTimeSpan();
		var end = editDay.Value.Date + endTime.Value.ToTimeSpan();
		if (end <= start)
		{
			error = "End time must be after start time.";
			return;
		}

		if (editingId is Guid id)
			await CalendarService.UpdateAsync(id, title, start, end, member, notes);
		else
			await CalendarService.AddAsync(title, start, end, member, notes);
		Cancel();
		await Refresh();
	}

	private async Task Remove()
	{
		if (editingId is Guid id) await CalendarService.RemoveAsync(id);
		Cancel();
		await Refresh();
	}
}
