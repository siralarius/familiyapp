@page "/"
@implements IDisposable

<PageTitle>Home · Family</PageTitle>
<div class="page"><header class="page-heading"><p class="eyebrow">@Weekday</p><h1>@Greeting</h1><p class="lede">Everything your household needs in one single place.</p></header><div class="dashboard-grid"><section class="card feature-card"><div><p class="card-label">Tonight</p><h2>No meal planned yet</h2><p>Plan dinner for the family.</p></div><a class="text-action" href="/meals">Plan a meal <span>→</span></a></section><section class="card"><p class="card-label">Shopping</p><div class="metric">0</div><p>items left to pick up</p><a class="text-action" href="/shopping">Open list <span>→</span></a></section><section class="card"><p class="card-label">Running low</p><div class="metric">0</div><p>household items need attention</p><a class="text-action" href="/more">Check inventory <span>→</span></a></section><section class="card"><p class="card-label">Today</p><h2>Nothing scheduled</h2><p>Your family calendar is clear.</p><a class="text-action" href="/calendar">View calendar <span>→</span></a></section></div></div>

@code {
    private DateTime _now = DateTime.Now;
    private Timer? _timer;

    private string Weekday => HomeDateGreeting.GetWeekdayName(_now);
    private string Greeting => HomeDateGreeting.GetGreeting(_now);

    protected override void OnInitialized()
    {
        _timer = new Timer(_ => _ = InvokeAsync(RefreshDateTime), null, HomeDateGreeting.GetNextRefreshDelay(_now), TimeSpan.FromMinutes(1));
    }

    private void RefreshDateTime()
    {
        _now = DateTime.Now;
        StateHasChanged();
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}
