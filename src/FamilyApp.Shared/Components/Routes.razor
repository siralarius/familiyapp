<Router AppAssembly="@typeof(Routes).Assembly" AdditionalAssemblies="@AdditionalAssemblies">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(FamilyApp.Shared.Components.Layout.AppShell)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(FamilyApp.Shared.Components.Layout.AppShell)">
            <div class="page"><h1>Not found</h1><p>That page doesn't exist.</p></div>
        </LayoutView>
    </NotFound>
</Router>

@code {
    [Parameter] public IEnumerable<System.Reflection.Assembly>? AdditionalAssemblies { get; set; }
}
